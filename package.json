{
  "name": "diagramador-uml",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:ghpages": "ng build --configuration production --base-href /diagramador_uml/",
    "deploy": "npm run build:ghpages && npx --yes angular-cli-ghpages --no-silent --dir=dist/diagramador-uml/browser",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "dependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "@joint/core": "4.3.3",
    "@popperjs/core": "2.11.8",
    "bootstrap": "5.3.8",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "typescript": "6.0.3"
  }
}
